# Shared project config
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_DB=mydb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
